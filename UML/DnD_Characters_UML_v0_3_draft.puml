@startuml DnD_Characters_v0_3_draft
' Focused revision of Characters package based on DnD_TrainingTool_UML_v0_2.puml
' This is a domain design proposal, not an implementation-ready contract.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty methods
left to right direction

package "Characters — persistent sheets" {
  abstract class CreatureSheet {
    +Id: Guid
    +Name: string
    +CreatureType: CreatureType
  }
  class PlayerCharacter
  class NonPlayerCharacter
  class CharacterIdentity {
    +Backstory: string
    +Appearance: string
    +PersonalityNotes: string
  }
  class StatBlockReference {
    +DefinitionId: ContentId
  }
  class NpcOverrides {
    +CustomName: string [0..1]
    +Notes: string
  }
  CreatureSheet <|-- PlayerCharacter
  CreatureSheet <|-- NonPlayerCharacter
  PlayerCharacter "1" *-- "1" CharacterBuild
  PlayerCharacter "1" *-- "1" CharacterIdentity
  NonPlayerCharacter "1" *-- "1" StatBlockReference
  NonPlayerCharacter "1" *-- "0..1" NpcOverrides
  CreatureSheet "1" *-- "1" CreatureBaseStatistics
  CreatureSheet "1" *-- "1" Inventory
  CreatureSheet "1" *-- "0..*" GrantedCapability
  CreatureSheet "1" *-- "0..*" SpellcastingSource
  CreatureSheet "1" *-- "0..1" PersistentCreatureState
}

package "Characters — base statistics" {
  class CreatureBaseStatistics <<aggregate>>
  class AbilityScores <<value object>> {
    +Strength: int
    +Dexterity: int
    +Constitution: int
    +Intelligence: int
    +Wisdom: int
    +Charisma: int
    +GetScore(ability: Ability): int
  }
  class DefenseProfile {
    +BaseArmorClass: int [0..1]
  }
  class HitPointProfile {
    +BaseMaximum: int [0..1]
  }
  class MovementProfile
  class SenseProfile
  class ProficiencyProfile
  class ProficiencyGrant {
    +ProficiencyId: ContentId
    +Source: SourceReference
  }
  class SourceReference <<value object>> {
    +SourceKind: string
    +SourceId: string
  }
  CreatureBaseStatistics "1" *-- "1" AbilityScores
  CreatureBaseStatistics "1" *-- "1" DefenseProfile
  CreatureBaseStatistics "1" *-- "1" HitPointProfile
  CreatureBaseStatistics "1" *-- "1" MovementProfile
  CreatureBaseStatistics "1" *-- "1" SenseProfile
  CreatureBaseStatistics "1" *-- "1" ProficiencyProfile
  ProficiencyProfile "1" *-- "0..*" ProficiencyGrant
  ProficiencyGrant --> SourceReference
}

package "Characters — character build" {
  class CharacterBuild
  class SpeciesSelection {
    +SpeciesId: ContentId
  }
  class SpeciesOptionSelection {
    +OptionId: ContentId
    +SelectedValueIds: List<ContentId>
  }
  class BackgroundSelection {
    +BackgroundId: ContentId
  }
  class CharacterProgression {
    +InitialClassId: ContentId
    +/TotalLevel: int
  }
  class ClassProgression <<derived summary>> {
    +ClassId: ContentId
    +/Level: int
    +SubclassId: ContentId [0..1]
  }
  class LevelUpRecord {
    +CharacterLevel: int
    +ClassId: ContentId
  }
  class CharacterChoice {
    +ChoiceId: ContentId
    +SelectedValues: List<ContentId>
  }
  CharacterBuild "1" *-- "1" SpeciesSelection
  CharacterBuild "1" *-- "1" BackgroundSelection
  CharacterBuild "1" *-- "1" CharacterProgression
  SpeciesSelection "1" *-- "0..*" SpeciesOptionSelection
  CharacterProgression "1" *-- "1..*" LevelUpRecord
  CharacterProgression "1" ..> "1..*" ClassProgression : derives summary
  LevelUpRecord "1" *-- "0..*" CharacterChoice
}

package "Characters — inventory, capabilities, spells" {
  class Inventory
  class ItemInstance {
    +Id: Guid
    +DefinitionId: ContentId
    +Quantity: int
  }
  class EquipmentLoadout {
    +EquippedItemIds: List<Guid>
  }
  class GrantedCapability {
    +DefinitionId: ContentId
    +Source: SourceReference
  }
  class SpellcastingSource {
    +Source: SourceReference
    +CastingAbility: Ability
  }
  class SpellAccess {
    +SpellId: ContentId
    +AcquisitionMode: string
    +PreparationMode: string
  }
  class CastingPermission {
    +CastingMode: string
    +ResourceDefinitionId: ContentId [0..1]
  }
  Inventory "1" *-- "0..*" ItemInstance
  Inventory "1" *-- "1" EquipmentLoadout
  EquipmentLoadout ..> "0..*" ItemInstance : references by Id
  GrantedCapability --> SourceReference
  SpellcastingSource --> SourceReference
  SpellcastingSource "1" *-- "0..*" SpellAccess
  SpellAccess "1" *-- "1..*" CastingPermission
}

package "Characters — persistent and runtime state" {
  class CreatureState {
    +CurrentHP: int
    +TemporaryHP: int
  }
  class PersistentCreatureState {
    +SavedAt: DateTime
  }
  class CreatureInstance {
    +InstanceId: Guid
    +SourceSheetId: Guid [0..1]
  }
  class CreatureSnapshot {
    +RulesetId: string
    +ResolvedContentVersions: string
  }
  class ResourcePool {
    +DefinitionId: ContentId
    +Current: int
  }
  class ActiveEffect {
    +Id: Guid
    +EffectId: ContentId
  }
  class ConditionInstance {
    +ConditionId: ContentId
  }
  class ConcentrationState {
    +OriginEffectId: Guid
  }
  PersistentCreatureState "1" *-- "1" CreatureState
  CreatureInstance "1" *-- "1" CreatureSnapshot
  CreatureInstance "1" *-- "1" CreatureState
  CreatureSnapshot ..> CreatureSheet : copied from; no mutable references
  CreatureState "1" *-- "0..*" ResourcePool
  CreatureState "1" *-- "0..*" ActiveEffect
  CreatureState "1" *-- "0..*" ConditionInstance
  CreatureState "1" *-- "0..1" ConcentrationState
}

package "Rules — calculated projections (external)" {
  class CalculatedCreatureStatistics <<read-only projection>> {
    +ArmorClass: int
    +MaximumHitPoints: int
    +InitiativeBonus: int
    +ProficiencyBonus: int
    +PassivePerception: int
  }
  class StatResolver
  StatResolver ..> CreatureBaseStatistics
  StatResolver ..> CreatureState
  StatResolver ..> CalculatedCreatureStatistics
}

package "Content — references (external)" {
  class ContentId <<value object>>
  class SpeciesDefinition
  class SpeciesOptionDefinition
  class BackgroundDefinition
  class ClassDefinition
  class NpcStatBlockDefinition
  class SpellDefinition
  class ItemDefinition
}
SpeciesSelection ..> SpeciesDefinition : resolves SpeciesId
SpeciesOptionSelection ..> SpeciesOptionDefinition : resolves OptionId
BackgroundSelection ..> BackgroundDefinition : resolves BackgroundId
LevelUpRecord ..> ClassDefinition : resolves ClassId
StatBlockReference ..> NpcStatBlockDefinition : resolves DefinitionId
SpellAccess ..> SpellDefinition : resolves SpellId
ItemInstance ..> ItemDefinition : resolves DefinitionId

note bottom of CreatureSheet
  A sheet is the persistent entity and configuration.
  PlayerCharacter and NonPlayerCharacter differ in construction.
  CreatureType is the D&D creature taxonomy, not PC/NPC role.
end note
note bottom of CreatureBaseStatistics
  Contains baseline inputs only, not resolved AC,
  proficiency bonus or initiative.
  NPC stat block values can be explicit baselines.
end note
note bottom of CharacterProgression
  LevelUpRecord preserves exact acquisition order.
  ClassProgression is shown as a derived summary to
  avoid two independently editable level counts.
end note
note bottom of CreatureInstance
  Owns an independent snapshot and runtime state.
  The original saved sheet is never mutated by simulation.
end note
note bottom of SpellAccess
  Preparation and casting permission are separate.
  Shared slot pools belong in CreatureState,
  rather than in a class-specific casting profile.
end note
@enduml
