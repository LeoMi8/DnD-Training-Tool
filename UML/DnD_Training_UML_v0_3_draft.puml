@startuml DnD_Training_v0_3_draft
' Training v0.3 — learning content, exercises, assessment
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

package "Training — learning content" {
  class TrainingModule {
    +Id: Guid
    +Title: string
    +Audience: TrainingAudience
  }
  enum TrainingAudience {
    Player
    DungeonMaster
    Both
  }
  class Lesson {
    +Id: Guid
    +Title: string
  }
  abstract class LessonStep {
    +Id: Guid
    +Order: int
  }
  class ExplanationStep {
    +Content: string
  }
  class QuestionStep {
    +QuestionId: Guid
  }
  class SimulationStep {
    +ScenarioId: Guid
  }
  TrainingModule "1" *-- "0..*" Lesson
  Lesson "1" *-- "1..*" LessonStep
  LessonStep <|-- ExplanationStep
  LessonStep <|-- QuestionStep
  LessonStep <|-- SimulationStep
  TrainingModule --> TrainingAudience
}

package "Training — exercise definitions" {
  class TrainingExercise {
    +Id: Guid
    +Title: string
    +Difficulty: DifficultyLevel
  }
  enum DifficultyLevel {
    Introductory
    Intermediate
    Advanced
  }
  class TrainingObjective {
    +Id: Guid
    +Description: string
  }
  class ExerciseSetup {
    +ScenarioId: Guid
    +Seed: long
  }
  class HintDefinition {
    +Text: string
    +WhenAvailable: string
  }
  TrainingModule "1" *-- "0..*" TrainingExercise
  TrainingExercise "1" *-- "1..*" TrainingObjective
  TrainingExercise "1" *-- "0..*" HintDefinition
  TrainingExercise "1" *-- "0..1" ExerciseSetup
  TrainingExercise --> DifficultyLevel
}

package "Training — attempts and learning progress" {
  class TrainingAttempt {
    +Id: Guid
    +ExerciseId: Guid
    +Status: TrainingStatus
    +StartedAt: DateTimeOffset
  }
  enum TrainingStatus {
    NotStarted
    InProgress
    Completed
    Abandoned
  }
  class LearnerProgress {
    +LearnerId: Guid
  }
  class LessonCompletion {
    +LessonId: Guid
    +CompletedAt: DateTimeOffset
  }
  class ExerciseCompletion {
    +ExerciseId: Guid
    +BestResultId: Guid
  }
  class AttemptEvidence {
    +EventId: Guid
    +Timestamp: DateTimeOffset
  }
  LearnerProgress "1" *-- "0..*" LessonCompletion
  LearnerProgress "1" *-- "0..*" ExerciseCompletion
  LearnerProgress "1" *-- "0..*" TrainingAttempt
  TrainingAttempt "1" *-- "0..*" AttemptEvidence
  TrainingAttempt --> TrainingExercise : based on
  TrainingAttempt --> TrainingStatus
}

package "Training — assessment and feedback" {
  interface IAssessmentStrategy {
    +Evaluate(context: AssessmentContext): AssessmentResult
  }
  class RuleValidationStrategy
  class ObjectiveValidationStrategy
  class DecisionReviewStrategy
  class AssessmentContext {
    +AttemptId: Guid
  }
  class AssessmentResult {
    +Id: Guid
    +Completed: bool
    +OptionalScore: decimal
  }
  class Feedback {
    +Type: FeedbackType
    +Message: string
    +SourceEventId: Guid
  }
  enum FeedbackType {
    Information
    Error
    Suggestion
    Reflection
  }
  class TrainingAssessmentService {
    +EvaluateAttempt(attemptId: Guid): AssessmentResult
  }
  IAssessmentStrategy <|.. RuleValidationStrategy
  IAssessmentStrategy <|.. ObjectiveValidationStrategy
  IAssessmentStrategy <|.. DecisionReviewStrategy
  TrainingAssessmentService --> IAssessmentStrategy
  IAssessmentStrategy ..> AssessmentContext
  IAssessmentStrategy ..> AssessmentResult
  AssessmentResult "1" *-- "0..*" Feedback
  TrainingAttempt "1" o-- "0..*" AssessmentResult
  Feedback --> FeedbackType
}

package "External contracts" {
  class SimulationSession
  class SimulationScenario
  class SimulationHistory
  class SimulationEvent
  class RuleExplanation
  class RuleOutcome
}
ExerciseSetup --> SimulationScenario : refers to
TrainingAttempt --> SimulationSession : optional exercise run
AssessmentContext --> SimulationHistory : evidence
RuleValidationStrategy --> RuleOutcome
RuleValidationStrategy --> RuleExplanation
ObjectiveValidationStrategy --> SimulationEvent
DecisionReviewStrategy --> SimulationHistory
note bottom of IAssessmentStrategy
  Correctness under rules, goal completion and decision quality
  are different assessments. Narrative choices may have no
  numerical score and require explainable qualitative feedback.
end note
note bottom of TrainingAttempt
  Attempts are independent; restarting an exercise does not
  overwrite earlier results. Progress is an aggregation of attempts.
end note
note bottom of TrainingModule
  Training depends on Simulation; a simulation must remain usable
  in free-play mode without any active lesson or assessment.
end note
@enduml
