@startuml DnD_Content_v0_3_draft
' Reconciled with DnD_Characters_UML_v0_3_draft.puml (14 Nov 2026)
' Candidate model, not final implementation contract.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty methods
left to right direction

package "Content — catalog and source" {
  class ContentId <<value object>> {
    +PackId: string
    +LocalId: string
  }
  class ContentPack {
    +Id: string
    +Version: string
    +RulesetId: string
  }
  class ContentManifest {
    +SchemaVersion: string
    +Distribution: string
    +LicenseStatus: string
  }
  abstract class ContentDefinition {
    +Id: ContentId
    +Name: string
    +Description: string
  }
  interface IContentRegistry {
    +Resolve(id: ContentId): ContentDefinition
  }
  class ContentPackLoader {
    +Load(path: string): ContentPack
  }
  ContentPack "1" *-- "1" ContentManifest
  ContentPack "1" o-- "0..*" ContentDefinition : publishes
  IContentRegistry ..> ContentDefinition
  ContentPackLoader ..> ContentPack
}

package "Content — character options" {
  class SpeciesDefinition
  class SpeciesOptionDefinition {
    +OptionId: ContentId
    +SelectionGroupId: string
  }
  class BackgroundDefinition
  class ClassDefinition {
    +HitDie: int
  }
  class ClassLevelDefinition {
    +Level: int
  }
  class SubclassDefinition {
    +ParentClassId: ContentId
  }
  class FeatDefinition
  class FeatureDefinition
  class ChoiceDefinition {
    +Id: ContentId
    +MinSelections: int
    +MaxSelections: int
  }
  class RequirementDefinition {
    +RuleKey: string
  }

  ContentDefinition <|-- SpeciesDefinition
  ContentDefinition <|-- BackgroundDefinition
  ContentDefinition <|-- ClassDefinition
  ContentDefinition <|-- SubclassDefinition
  ContentDefinition <|-- FeatDefinition
  ContentDefinition <|-- FeatureDefinition
  SpeciesDefinition "1" *-- "0..*" SpeciesOptionDefinition : optional selections
  ClassDefinition "1" *-- "1..*" ClassLevelDefinition
  ClassDefinition "1" --> "0..*" SubclassDefinition : allowed
  ClassDefinition "1" --> "0..*" RequirementDefinition : multiclass prerequisites
  ClassLevelDefinition "1" *-- "0..*" ChoiceDefinition
  ChoiceDefinition "1" *-- "0..*" RequirementDefinition
}

package "Content — grants and effects" {
  class GrantDefinition {
    +Kind: GrantKind
    +TargetId: ContentId [0..1]
  }
  enum GrantKind {
    Feature
    Proficiency
    SpellAccess
    Action
    Resource
    Effect
  }
  abstract class EffectDefinition {
    +EffectId: ContentId
  }
  class NumericModifierEffect {
    +StatKey: string
    +Operator: ModifierOperator
    +ValueExpression: string
  }
  enum ModifierOperator {
    Add
    Set
    Minimum
    Maximum
  }
  class DamageEffectDefinition
  class HealingEffectDefinition
  class ConditionEffectDefinition
  class ResourceEffectDefinition
  class GrantEffectDefinition
  class EffectApplicability {
    +PredicateKey: string
  }
  class EffectDurationDefinition {
    +DurationKey: string
  }

  GrantDefinition --> GrantKind
  GrantDefinition --> "0..*" EffectDefinition : direct effects
  EffectDefinition <|-- NumericModifierEffect
  EffectDefinition <|-- DamageEffectDefinition
  EffectDefinition <|-- HealingEffectDefinition
  EffectDefinition <|-- ConditionEffectDefinition
  EffectDefinition <|-- ResourceEffectDefinition
  EffectDefinition <|-- GrantEffectDefinition
  EffectDefinition "1" *-- "0..*" EffectApplicability
  EffectDefinition "1" *-- "0..1" EffectDurationDefinition
  NumericModifierEffect --> ModifierOperator

  SpeciesDefinition "1" *-- "0..*" GrantDefinition
  SpeciesOptionDefinition "1" *-- "0..*" GrantDefinition
  BackgroundDefinition "1" *-- "0..*" GrantDefinition
  ClassLevelDefinition "1" *-- "0..*" GrantDefinition
  SubclassDefinition "1" *-- "0..*" GrantDefinition
  FeatDefinition "1" *-- "0..*" GrantDefinition
  FeatureDefinition "1" *-- "0..*" GrantDefinition
}

package "Content — actions, spells and resources" {
  class ActionDefinition {
    +ActionId: ContentId
    +Name: string
  }
  class ActivationDefinition {
    +TimingKey: string
    +TriggerKey: string [0..1]
  }
  class TargetingDefinition {
    +RangeExpression: string
  }
  class SpellDefinition {
    +Level: int
    +School: string
  }
  class SpellcastingDefinition {
    +CastingAbility: string [0..1]
  }
  class ResourceDefinition {
    +MaximumExpression: string
  }
  class ResourceCost {
    +ResourceId: ContentId
    +AmountExpression: string
  }
  class RecoveryRule {
    +RecoveryKey: string
  }
  class ItemDefinition
  class ConditionDefinition

  ContentDefinition <|-- ActionDefinition
  ContentDefinition <|-- SpellDefinition
  ContentDefinition <|-- ResourceDefinition
  ContentDefinition <|-- ItemDefinition
  ContentDefinition <|-- ConditionDefinition
  ActionDefinition "1" *-- "1" ActivationDefinition
  ActionDefinition "1" *-- "0..1" TargetingDefinition
  ActionDefinition "1" *-- "0..*" ResourceCost
  ActionDefinition "1" *-- "0..*" EffectDefinition : ordered outcomes
  SpellDefinition "1" --> "1" ActionDefinition : cast action
  ResourceDefinition "1" *-- "0..*" RecoveryRule
  ResourceCost ..> ResourceDefinition : resolves ResourceId
  SpellcastingDefinition --> "0..*" SpellDefinition : spell options
}

package "Content — NPCs and monsters" {
  class NpcStatBlockDefinition {
    +ChallengeRating: string
    +CreatureType: string
    +ArmorClassBaseline: int
    +HitPointsBaseline: int
  }
  class StatBlockActionEntry {
    +ActionId: ContentId
    +Section: string
  }
  ContentDefinition <|-- NpcStatBlockDefinition
  NpcStatBlockDefinition "1" *-- "0..*" StatBlockActionEntry
  StatBlockActionEntry ..> ActionDefinition
  NpcStatBlockDefinition "1" --> "0..*" FeatureDefinition : grants
  NpcStatBlockDefinition "1" *-- "0..*" SpellcastingDefinition
}

package "Characters — external references" {
  class SpeciesSelection {
    +SpeciesId: ContentId
  }
  class SpeciesOptionSelection {
    +OptionId: ContentId
  }
  class BackgroundSelection {
    +BackgroundId: ContentId
  }
  class LevelUpRecord {
    +ClassId: ContentId
  }
  class CharacterChoice {
    +ChoiceId: ContentId
  }
  class StatBlockReference {
    +DefinitionId: ContentId
  }
  class GrantedCapability {
    +DefinitionId: ContentId
  }
  class SpellAccess {
    +SpellId: ContentId
  }
  class ItemInstance {
    +DefinitionId: ContentId
  }
  class ActiveEffect {
    +EffectId: ContentId
  }
}

SpeciesSelection ..> SpeciesDefinition : resolves ID
SpeciesOptionSelection ..> SpeciesOptionDefinition : resolves ID
BackgroundSelection ..> BackgroundDefinition : resolves ID
LevelUpRecord ..> ClassDefinition : resolves ID
CharacterChoice ..> ChoiceDefinition : resolves ID
StatBlockReference ..> NpcStatBlockDefinition : resolves ID
GrantedCapability ..> ContentDefinition : resolves ID
SpellAccess ..> SpellDefinition : resolves ID
ItemInstance ..> ItemDefinition : resolves ID
ActiveEffect ..> EffectDefinition : resolves ID

package "Rules — execution only (external)" {
  class RulesEngine
  class GrantResolver
  class ModifierResolver
  class EffectResolver
  class RequirementEvaluator
}
RulesEngine --> GrantResolver
RulesEngine --> ModifierResolver
RulesEngine --> EffectResolver
GrantResolver ..> GrantDefinition
ModifierResolver ..> NumericModifierEffect
EffectResolver ..> EffectDefinition
RequirementEvaluator ..> RequirementDefinition

note bottom of GrantDefinition
  A grant explains what is made available to a character.
  It is not an applied temporary effect and is not a
  mutation of the character's stored ability scores.
end note
note bottom of NumericModifierEffect
  Modifier semantics and stacking/order are resolved by Rules.
  Content only stores declarative data.
end note
note bottom of ContentPack
  Ruleset and licensing metadata are not runtime effects.
  Distribution requires separate legal review.
end note
note bottom of NpcStatBlockDefinition
  NPC and monster definitions share a stat block.
  PC construction uses CharacterBuild instead.
end note
note bottom of SpellcastingDefinition
  This defines a content-granted spellcasting capability;
  Characters stores the actual source, available spells,
  preparation state and casting permissions.
end note
@enduml
