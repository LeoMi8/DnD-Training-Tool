@startuml DnD_World_v0_3_draft
' World v0.3 — geometry, places, occupancy, interaction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

package "World — areas and map data" {
  class GameWorld {
    +Id: Guid
    +Name: string
  }
  class GameArea {
    +Id: Guid
    +Name: string
    +Description: string
  }
  class GameMap {
    +Id: Guid
    +Scale: decimal
    +CoordinateSystem: CoordinateSystem
  }
  enum CoordinateSystem {
    Square
    Hexagonal
    Continuous
  }
  class Position <<value object>> {
    +X: decimal
    +Y: decimal
    +Z: decimal
  }
  class MapGeometry {
    +Bounds: GeometryBounds
  }
  class GeometryBounds <<value object>>
  class TerrainRegion {
    +Id: Guid
    +MovementCostFactor: decimal
    +BlocksMovement: bool
    +BlocksSight: bool
  }
  GameWorld "1" *-- "0..*" GameArea
  GameArea "1" o-- "0..1" GameMap
  GameMap "1" *-- "1" MapGeometry
  GameMap "1" *-- "0..*" TerrainRegion
  MapGeometry --> GeometryBounds
  GameMap --> CoordinateSystem
  TerrainRegion --> MapGeometry : region geometry
}

package "World — topology and geometry rules" {
  interface ISpatialRules {
    +MeasureDistance(a: Position, b: Position): DistanceResult
    +ValidatePath(path: MovementPath, context: SpatialContext): SpatialResult
    +ComputeOccupiedArea(footprint: Footprint, at: Position): AreaShape
  }
  class SquareGridRules
  class HexGridRules
  class GridlessRules
  class SpatialContext {
    +MapId: Guid
  }
  class MovementPath {
    +Waypoints: List<Position>
  }
  class DistanceResult {
    +Distance: decimal
  }
  class SpatialResult {
    +Allowed: bool
    +Cost: decimal
    +BlockingReasons: List<string>
  }
  class Footprint {
    +Shape: FootprintShape
    +Size: decimal
  }
  enum FootprintShape {
    Square
    Hex
    Circle
    Custom
  }
  class AreaShape <<value object>>
  ISpatialRules <|.. SquareGridRules
  ISpatialRules <|.. HexGridRules
  ISpatialRules <|.. GridlessRules
  GameMap --> ISpatialRules : selects strategy
  ISpatialRules ..> SpatialContext
  ISpatialRules ..> MovementPath
  ISpatialRules ..> Footprint
  ISpatialRules ..> DistanceResult
  ISpatialRules ..> SpatialResult
  Footprint --> FootprintShape
  Footprint --> AreaShape : resolved at position
}

package "World — scene state, occupancy and perception" {
  class SceneState {
    +AreaId: Guid
  }
  class EntityPlacement {
    +EntityInstanceId: Guid
    +Position: Position
    +Orientation: decimal
  }
  class OccupancyIndex {
    +IsOccupied(shape: AreaShape): bool
    +GetNearby(at: Position): List<Guid>
  }
  class VisibilityResolver {
    +HasLineOfSight(a: Position, b: Position): bool
  }
  class CoverResolver {
    +EvaluateCover(a: Position, b: Position): CoverResult
  }
  class CoverResult {
    +CoverCategory: string
  }
  class HazardInstance {
    +Id: Guid
    +EffectId: ContentId
    +Area: AreaShape
  }
  SceneState "1" *-- "0..*" EntityPlacement
  SceneState "1" *-- "0..*" HazardInstance
  OccupancyIndex ..> SceneState : indexes placements
  VisibilityResolver ..> MapGeometry
  VisibilityResolver ..> SceneState
  CoverResolver ..> MapGeometry
  CoverResolver ..> SceneState
  CoverResolver ..> CoverResult
}

package "World — interactable objects" {
  class WorldObjectDefinition {
    +Id: ContentId
    +Name: string
  }
  class WorldObjectInstance {
    +Id: Guid
    +DefinitionId: ContentId
  }
  class ObjectState {
    +IsOpen: bool
    +IsLocked: bool
    +IsDestroyed: bool
  }
  class InteractionOption {
    +ActionId: ContentId
    +RequirementId: ContentId
  }
  class WorldInteractionRequest {
    +ActorInstanceId: Guid
    +ObjectInstanceId: Guid
    +InteractionId: ContentId
  }
  WorldObjectDefinition "1" o-- "0..*" InteractionOption
  WorldObjectInstance "1" *-- "1" ObjectState
  WorldObjectInstance --> WorldObjectDefinition : references by id
  SceneState "1" *-- "0..*" WorldObjectInstance
  WorldInteractionRequest ..> InteractionOption
}

package "External contracts" {
  class ContentId <<value object>>
  class CreatureInstance
  class CombatMovementRequest
  class MovementCoordinator
  class RulesEngine
}
EntityPlacement ..> CreatureInstance : may locate
MovementCoordinator --> ISpatialRules : distance and path
MovementCoordinator --> OccupancyIndex : physical blocking
MovementCoordinator --> RulesEngine : movement restrictions
WorldInteractionRequest ..> RulesEngine : validate/check
note bottom of ISpatialRules
  Map geometry and terrain do not implement combat action economy.
  Square grids permit configurable diagonal-distance policies;
  hex grids use axial/cube coordinates internally;
  gridless uses continuous distances and optional UI snapping.
end note
note bottom of EntityPlacement
  Runtime placement belongs to SceneState, not to the saved
  creature definition. One instance can be in one location
  at a time within one simulation scene.
end note
note bottom of VisibilityResolver
  Geometry-based line of sight and rule-based visibility
  (lighting, senses, invisibility) are distinct calculations.
end note
@enduml
